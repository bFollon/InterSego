// Copy this file to Secrets.swift and fill in the real values.
// Secrets.swift is gitignored — never commit the actual keys.
extension AppConfig {
    /// Bearer token required by the server for all authenticated endpoints.
    static let boardingAPIKey = "<BOARDING_API_KEY>"

    /// Bugsink DSN for error reporting (Sentry-compatible).
    static let sentryDSN = "<SENTRY_DSN>"

    /// Aptabase app key for analytics.
    static let aptabaseKey = "<APTABASE_APP_KEY>"

    /// Self-hosted Aptabase instance URL.
    static let aptabaseHost = "<APTABASE_HOST>"
}
