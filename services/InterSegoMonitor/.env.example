# Bearer token for POST /check endpoint
# Generate a strong random value, e.g.: openssl rand -hex 32
API_KEY=replace_with_a_strong_secret

# iCloud SMTP credentials
# Sender address (your Apple ID email)
SMTP_USER=follon.bruno@icloud.com
# App-specific password — generate at: appleid.apple.com → Sign-In & Security → App-Specific Passwords
SMTP_PASS=replace_with_app_specific_password

# Email address to receive change notifications
NOTIFY_EMAIL=bfollon.dev@icloud.com

# Port to listen on (default: 3701)
PORT=3701

# Host to bind to (default: 0.0.0.0)
HOST=0.0.0.0
