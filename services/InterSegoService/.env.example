# Bearer token that all app clients must include in the Authorization header.
# Generate a strong random value, e.g.: openssl rand -hex 32
API_KEY=replace_with_a_strong_secret

# Bearer token for operator-only actions (e.g. POST /api/timetables/reload).
# Keep this on the server only — never bundle it into the apps.
# Generate a separate strong random value, e.g.: openssl rand -hex 32
RELOAD_KEY=replace_with_a_strong_secret

# Port to listen on (default: 3000)
PORT=3000

# Host to bind to (default: 0.0.0.0)
HOST=0.0.0.0

# Absolute or relative path to the directory containing timetable JSON files.
# Relative paths are resolved from the working directory where `npm start` is run.
# Default: ../../resources/timetables (works when running from services/InterSegoService/)
# TIMETABLES_DIR=../../resources/timetables

# Absolute or relative path to the directory containing route polyline JSON files.
# Relative paths are resolved from the working directory where `npm start` is run.
# Default: ../../resources/route_polylines (works when running from services/InterSegoService/)
# POLYLINES_DIR=../../resources/route_polylines

# APNs (Apple Push Notification service) — required for iOS push notifications.
# Download the .p8 key from developer.apple.com → Certificates, IDs & Profiles → Keys.
# Store the key file on the server outside the repository.
APNS_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=com.github.bfollon.intersego
# Set to true for App Store / TestFlight builds; false for development / sandbox testing.
APNS_PRODUCTION=false

# FCM (Firebase Cloud Messaging) — required for Android push notifications.
# Generate a private key from Firebase Console → Project Settings → Service Accounts.
# Store the JSON key file on the server outside the repository.
FCM_SERVICE_ACCOUNT_PATH=/path/to/intersego-b4e66-firebase-adminsdk-xxx.json
FCM_PROJECT_ID=intersego-b4e66
